WOOCOMMERCE_URL=http://host.docker.internal:8080
WOOCOMMERCE_CONSUMER_KEY=
WOOCOMMERCE_CONSUMER_SECRET=

TRACEZILLA_BASE_URL=https://app.tracezilla.com
# The team slug is part of every API URL: /api/v1/{team-slug}/...
# Find it in the browser URL when the team is open in tracezilla.
TRACEZILLA_TEAM_SLUG=
# OAuth client for the Resource Owner Password Credentials grant. Create it in
# tracezilla under Settings > My account > API Tokens (Owner or Administrator
# role required). Then run bin/tracezilla-login once; it stores tokens in
# TRACEZILLA_TOKEN_FILE and they are renewed automatically.
# https://tech.tracezilla.com/docs/rest-api-v1/making-requests/authentication
TRACEZILLA_CLIENT_ID=
TRACEZILLA_CLIENT_SECRET=
TRACEZILLA_TOKEN_FILE=var/tracezilla-token.json
# Exact name of your company's own partner in tracezilla. The seed adds its
# warehouse location to this partner.
TRACEZILLA_OWN_COMPANY=

HTTP_TIMEOUT=30
HTTP_CONNECT_TIMEOUT=10
