#!/usr/bin/env php
<?php

declare(strict_types=1);

use Dotenv\Dotenv;
use Tracezilla\WooCommerce\Seed\SeedDefinition;
use Tracezilla\WooCommerce\Seed\Seeder;
use Tracezilla\WooCommerce\Seed\SeedResult;
use Tracezilla\WooCommerce\Seed\TracezillaSeedGateway;
use Tracezilla\WooCommerce\Tracezilla\Client;
use Tracezilla\WooCommerce\Tracezilla\TokenProvider;
use Tracezilla\WooCommerce\Tracezilla\TracezillaConfiguration;

require dirname(__DIR__).'/vendor/autoload.php';

Dotenv::createImmutable(dirname(__DIR__))->safeLoad();

$usage = <<<'TEXT'
    Usage: php bin/bifrost-connect tracezilla:seed [<seed-file>] [--execute --confirm]

    Creates the partners, locations, SKUs and purchase orders described in the
    seed file in the tracezilla team from .env. Existing records are skipped.
    Locations under own_company are added to the partner named by
    TRACEZILLA_OWN_COMPANY.
    Without --execute --confirm nothing is written (dry run).

    Default seed file: seeds/tracezilla.yaml

    TEXT;

$arguments = array_slice($argv, 1);
if (in_array('--help', $arguments, true) || in_array('-h', $arguments, true)) {
    echo $usage;
    exit(0);
}

$execute = false;
$confirm = false;
$files = [];
foreach ($arguments as $argument) {
    if ($argument === '--execute') {
        $execute = true;
    } elseif ($argument === '--confirm') {
        $confirm = true;
    } elseif (str_starts_with($argument, '--')) {
        fwrite(STDERR, $usage);
        exit(2);
    } else {
        $files[] = $argument;
    }
}
if (count($files) > 1) {
    fwrite(STDERR, $usage);
    exit(2);
}
if ($execute !== $confirm) {
    fwrite(STDERR, "Writing requires both --execute and --confirm. Nothing was written.\n");
    exit(2);
}

$seedFile = dirname(__DIR__).'/seeds/tracezilla.yaml';
if (count($files) === 1) {
    $seedFile = $files[0];
}

try {
    $definition = SeedDefinition::fromFile($seedFile);
    $configuration = TracezillaConfiguration::fromEnvironment(dirname(__DIR__));
    printHeading($execute, $configuration->teamSlug);

    $tokens = TokenProvider::fromConfiguration($configuration);
    $client = new Client($configuration, $tokens);
    $seeder = new Seeder(new TracezillaSeedGateway($client), ownCompanyName(), $tokens->userId());
    $result = $seeder->run($definition, $execute);
} catch (Throwable $exception) {
    fwrite(STDERR, 'Seed failed: '.$exception->getMessage()."\n");
    exit(1);
}

printResult($result, $execute);

if ($result->isSuccessful()) {
    exit(0);
}
exit(1);

function printHeading(bool $execute, string $teamSlug): void
{
    if ($execute) {
        echo "Seeding tracezilla team [{$teamSlug}]\n\n";
    } else {
        echo "Dry run for tracezilla team [{$teamSlug}]\n\n";
    }
}

/** The own company's name from .env, or null if it is not set. */
function ownCompanyName(): ?string
{
    $name = (string) getenv('TRACEZILLA_OWN_COMPANY');
    if ($name === '') {
        return null;
    }

    return $name;
}

function printResult(SeedResult $result, bool $execute): void
{
    foreach ($result->items() as $item) {
        printf("%-15s %-14s %-35s %s\n", $item['type'], $item['action'], $item['key'], $item['detail']);
    }

    echo "\n";
    $counts = $result->counts();
    foreach ($counts as $action => $count) {
        echo "{$action}: {$count}\n";
    }

    $wouldCreateSomething = isset($counts[SeedResult::WOULD_CREATE]);
    if (! $execute && $wouldCreateSomething) {
        echo "\nDry run only. Re-run with --execute --confirm to write.\n";
    }
}
