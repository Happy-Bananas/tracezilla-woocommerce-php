#!/usr/bin/env php
<?php

declare(strict_types=1);

// Fills a development company in tracezilla with test data. The command
// itself is in bifrost-core (Bifrost\Core\Seed\SeedCommand); it uses
// seeds/tracezilla.yaml in this project if you add one, or else the standard
// test dataset.

use Bifrost\Core\Seed\SeedCommand;
use Dotenv\Dotenv;

$project = dirname(__DIR__);
require $project.'/vendor/autoload.php';
// createUnsafeImmutable also puts the values into getenv(), which the
// settings classes read. Without Docker that is the only way they arrive.
Dotenv::createUnsafeImmutable($project)->safeLoad();

$command = new SeedCommand($project);
exit($command->run(array_slice($argv, 1)));
