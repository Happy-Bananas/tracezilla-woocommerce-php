#!/usr/bin/env php
<?php

declare(strict_types=1);

use Dotenv\Dotenv;
use Tracezilla\WooCommerce\Configuration;
use Tracezilla\WooCommerce\WooCommerce\Client;

require dirname(__DIR__).'/vendor/autoload.php';

Dotenv::createImmutable(dirname(__DIR__))->safeLoad();

try {
    $configuration = Configuration::fromEnvironment();
    $status = (new Client($configuration))->systemStatus();

    echo "Connected to WooCommerce successfully.\n";
    echo 'Environment: '.($status['environment']['site_url'] ?? $configuration->wooCommerceUrl)."\n";
    echo 'WooCommerce: '.($status['environment']['version'] ?? 'unknown')."\n";
} catch (Throwable $exception) {
    fwrite(STDERR, 'Connection failed: '.$exception->getMessage()."\n");
    exit(1);
}

