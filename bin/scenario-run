#!/usr/bin/env php
<?php

declare(strict_types=1);

// Runs a scenario: its DataReader reads WooCommerce and tracezilla, its
// BusinessRules decide the result, and the changes the rules planned are
// written only with --execute --confirm. The result is printed as JSON.

use Dotenv\Dotenv;
use Tracezilla\WooCommerce\Configuration;
use Tracezilla\WooCommerce\Scenarios\LiveChangeWriter;
use Tracezilla\WooCommerce\Scenarios\ScenarioRunner;
use Tracezilla\WooCommerce\Scenarios\TracezillaReader;
use Tracezilla\WooCommerce\Scenarios\WooCommerceReader;
use Tracezilla\WooCommerce\Tracezilla\Client as TracezillaClient;
use Tracezilla\WooCommerce\Tracezilla\SkuCreator;
use Tracezilla\WooCommerce\Tracezilla\TokenProvider;
use Tracezilla\WooCommerce\Tracezilla\TracezillaConfiguration;
use Tracezilla\WooCommerce\WooCommerce\Client as WooCommerceClient;
use Tracezilla\WooCommerce\WriteMode;

$project = dirname(__DIR__);
require $project.'/vendor/autoload.php';
// createUnsafeImmutable also puts the values into getenv(), which the
// settings classes read. Without Docker that is the only way they arrive.
Dotenv::createUnsafeImmutable($project)->safeLoad();

$usage = <<<'TEXT'
    Usage: php bin/bifrost-connect scenario:run <name> [--dry-run | --execute --confirm] [--limit=<number>]

    A scenario that plans changes needs a mode:
      --dry-run              Report the planned changes. Nothing is written.
      --execute --confirm    Write the planned changes.
    --limit writes at most that many changes. A read-only scenario needs no mode.

    TEXT;

$name = null;
$dryRun = false;
$execute = false;
$confirm = false;
$limit = null;
foreach (array_slice($argv, 1) as $argument) {
    if ($argument === '--dry-run') {
        $dryRun = true;
    } elseif ($argument === '--execute') {
        $execute = true;
    } elseif ($argument === '--confirm') {
        $confirm = true;
    } elseif (str_starts_with($argument, '--limit=')) {
        $limit = positiveNumberOrNull(substr($argument, strlen('--limit=')));
        if ($limit === null) {
            fwrite(STDERR, $usage);
            exit(2);
        }
    } elseif (! str_starts_with($argument, '-') && $name === null) {
        $name = $argument;
    } else {
        fwrite(STDERR, $usage);
        exit(2);
    }
}
if ($name === null) {
    fwrite(STDERR, $usage);
    exit(2);
}
try {
    $mode = WriteMode::fromOptions($dryRun, $execute, $confirm);
} catch (InvalidArgumentException $exception) {
    fwrite(STDERR, $exception->getMessage()."\n");
    exit(2);
}

try {
    $wooCommerce = new WooCommerceClient(Configuration::fromEnvironment());
    $configuration = TracezillaConfiguration::fromEnvironment($project);
    $tracezilla = new TracezillaClient($configuration, TokenProvider::fromConfiguration($configuration));

    $runner = new ScenarioRunner(
        $project,
        new WooCommerceReader($wooCommerce),
        new TracezillaReader($tracezilla),
        new LiveChangeWriter(new SkuCreator($tracezilla)),
    );
    $result = $runner->run($name, $mode, $limit);
} catch (Throwable $exception) {
    fwrite(STDERR, 'Scenario failed: '.$exception->getMessage()."\n");
    exit(1);
}

echo json_encode($result, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES | JSON_THROW_ON_ERROR)."\n";

if (anyChangeFailed($result)) {
    exit(1);
}
exit(0);

/** The number in $text if it is a whole number of at least 1, otherwise null. */
function positiveNumberOrNull(string $text): ?int
{
    if (! ctype_digit($text)) {
        return null;
    }
    $number = (int) $text;
    if ($number < 1) {
        return null;
    }

    return $number;
}

/** @param array<string, mixed> $result */
function anyChangeFailed(array $result): bool
{
    if (! isset($result['changes'])) {
        return false;
    }
    foreach ($result['changes'] as $change) {
        if ($change['outcome'] === 'failed') {
            return true;
        }
    }

    return false;
}
