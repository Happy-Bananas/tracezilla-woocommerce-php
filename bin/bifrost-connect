#!/usr/bin/env php
<?php

declare(strict_types=1);

// The single entry point: runs one of the commands in bin/, taking the
// integration lock first unless the command may run alongside others.

use Dotenv\Dotenv;
use Tracezilla\WooCommerce\Lock\FileIntegrationLock;
use Tracezilla\WooCommerce\RuntimeDirectory;

$project = dirname(__DIR__);
require $project.'/vendor/autoload.php';
// createUnsafeImmutable also puts the values into getenv(), which the
// settings classes read. Without Docker that is the only way they arrive.
Dotenv::createUnsafeImmutable($project)->safeLoad();

$commands = [
    'connection:check' => 'check-connection',
    'tracezilla:login' => 'tracezilla-login',
    'tracezilla:seed' => 'seed-tracezilla',
    'scenario:create' => 'scenario-create',
    'scenario:run' => 'scenario-run',
];

// These commands may run while another command holds the integration lock.
// Every other command takes the lock, so scheduled runs never overlap; a run
// that finds the lock taken is skipped, not queued.
$unlockedCommands = ['connection:check', 'tracezilla:login', 'scenario:create'];

$command = 'help';
if (isset($argv[1])) {
    $command = $argv[1];
}

if (in_array($command, ['help', '--help', '-h', 'list'], true)) {
    printHelp(array_keys($commands));
    exit(0);
}
if (! isset($commands[$command])) {
    fwrite(STDERR, "Unknown command: {$command}\n");
    fwrite(STDERR, "Run 'php bin/bifrost-connect help' to list commands.\n");
    exit(2);
}

$lock = null;
if (! in_array($command, $unlockedCommands, true)) {
    $locks = new FileIntegrationLock(RuntimeDirectory::resolve($project));
    $lock = $locks->acquire('integration', ['command' => $command]);
    if ($lock === null) {
        reportSkippedRun($locks->metadata('integration'));
        exit(75);
    }
}

$script = __DIR__.DIRECTORY_SEPARATOR.$commands[$command];
$arguments = array_slice($argv, 2);
passthru(shellCommand($script, $arguments), $exitCode);

if ($lock !== null) {
    $lock->release();
}
exit($exitCode);

/** @param list<string> $commandNames */
function printHelp(array $commandNames): void
{
    echo "BifrostConnect\n\n";
    echo "Usage:\n";
    echo "  php bin/bifrost-connect <command> [options]\n\n";
    echo "Available commands:\n";
    foreach ($commandNames as $name) {
        echo "  {$name}\n";
    }
    echo "\nRun a command with its options, for example:\n";
    echo "  php bin/bifrost-connect tracezilla:seed --help\n";
}

/**
 * Explain that another command holds the lock, using what it wrote into the
 * lock file.
 *
 * @param array<string, mixed> $metadata
 */
function reportSkippedRun(array $metadata): void
{
    fwrite(STDERR, "Another integration command is already running.\n");
    if (isset($metadata['command']) && is_string($metadata['command'])) {
        fwrite(STDERR, "Command: {$metadata['command']}\n");
    }
    if (isset($metadata['acquired_at']) && is_string($metadata['acquired_at'])) {
        fwrite(STDERR, "Started: {$metadata['acquired_at']}\n");
    }
    fwrite(STDERR, "This invocation was skipped safely; the next scheduled run can retry.\n");
}

/**
 * The shell command that runs $script with this PHP and the given arguments.
 * Every part is quoted, so arguments with spaces stay one argument.
 *
 * @param list<string> $arguments
 */
function shellCommand(string $script, array $arguments): string
{
    $parts = [escapeshellarg(PHP_BINARY), escapeshellarg($script)];
    foreach ($arguments as $argument) {
        $parts[] = escapeshellarg($argument);
    }

    return implode(' ', $parts);
}
