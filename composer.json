{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "happy-bananas/tracezilla-woocommerce-php",
    "description": "Framework-neutral PHP templates for integrating WooCommerce with tracezilla.",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "guzzlehttp/guzzle": "^7.10",
        "vlucas/phpdotenv": "^5.6"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.3"
    },
    "autoload": {
        "psr-4": {
            "Tracezilla\\WooCommerce\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    }
}

